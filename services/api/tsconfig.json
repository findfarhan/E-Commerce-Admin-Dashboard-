{
  "compilerOptions":{
    "target":"ES2022",
    "module":"commonjs",
    "moduleResolution":"node",
    "rootDir":"src",
    "outDir":"dist",
    "strict":true,
    "esModuleInterop":true,
    "skipLibCheck":true,
    "experimentalDecorators":true,
    "emitDecoratorMetadata":true,
    "sourceMap":true,
    "declaration":false,
    "types":["node"]
  },
  "include":["src/**/*.ts"]
}