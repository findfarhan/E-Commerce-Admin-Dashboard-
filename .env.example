NEXT_PUBLIC_ADMIN_NAME=Jewelry Control
NEXT_PUBLIC_STOREFRONT_URL=https://jewelry-store-lime.vercel.app
NEXT_PUBLIC_API_URL=https://e-commerce-admin-dashboard-ptgs.onrender.com

# Admin Vercel only.
ADMIN_API_KEY=
ADMIN_UI_USERNAME=
ADMIN_UI_PASSWORD=

# Render backend only — Supabase Postgres connection string.
DATABASE_URL=postgresql://...
DB_POOL_MAX=5
DB_SSL=true
PUBLIC_RATE_LIMIT_PER_MINUTE=120

# Media provider abstraction.
MEDIA_STORAGE_PROVIDER=source-url

# Cloudflare R2 — later phase / Render backend only.
CLOUDFLARE_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
R2_UPLOAD_URL_TTL_SECONDS=900
CLOUDFLARE_IMAGE_RESIZING_BASE_URL=

# Render API security / CORS.
ADMIN_ALLOWED_ORIGINS=
STOREFRONT_ALLOWED_ORIGINS=https://jewelry-store-lime.vercel.app
STORE_DOMAIN=jewelry-store-lime.vercel.app
APP_RUNTIME=api
